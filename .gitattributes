# Force LF line endings for all text files (matches .editorconfig).
# Git for Windows ships core.autocrlf=true; without this line every clone
# checks out as CRLF and scripted edits built with "\n" silently no-op.
* text=auto eol=lf

# Windows entry points stay CRLF: cmd.exe is the one shell where LF is
# genuinely less safe (a final line without CRLF can be mis-parsed).
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets - never line-ending-convert or text-diff these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.zip   binary
